{
  "name": "@gkd-kit/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "type-check": "pnpm types && tsc && tsc -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:migrate:local": "wrangler d1 migrations apply gkd --local",
    "d1:migrate:remote": "wrangler d1 migrations apply gkd --remote",
    "check": "pnpm type-check && pnpm test && wrangler deploy --dry-run"
  },
  "dependencies": {
    "fflate": "catalog:",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.7.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "error"
    }
  }
}
